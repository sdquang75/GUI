<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>CS8618</NoWarn>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>GUI 1.0.3</AssemblyTitle>
    <Product>GUI 1.0.3</Product>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
    <EmbeddedResource Include="Resources\goodbyedpi\goodbyedpi.exe" LogicalName="GUI.Goodbyedpi.goodbyedpi.exe" Condition="Exists('Resources\goodbyedpi\goodbyedpi.exe')" />
    <EmbeddedResource Include="Resources\goodbyedpi\WinDivert.dll" LogicalName="GUI.Goodbyedpi.WinDivert.dll" Condition="Exists('Resources\goodbyedpi\WinDivert.dll')" />
    <EmbeddedResource Include="Resources\goodbyedpi\WinDivert64.sys" LogicalName="GUI.Goodbyedpi.WinDivert64.sys" Condition="Exists('Resources\goodbyedpi\WinDivert64.sys')" />
  </ItemGroup>

</Project>