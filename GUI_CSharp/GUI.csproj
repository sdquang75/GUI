<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>CS8618</NoWarn>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
    <EmbeddedResource Include="..\goodbyedpi-0.2.2\goodbyedpi-0.2.2\x86_64\goodbyedpi.exe" LogicalName="GUI.Goodbyedpi.goodbyedpi.exe" Condition="Exists('..\goodbyedpi-0.2.2\goodbyedpi-0.2.2\x86_64\goodbyedpi.exe')" />
    <EmbeddedResource Include="..\goodbyedpi-0.2.2\goodbyedpi-0.2.2\x86_64\WinDivert.dll" LogicalName="GUI.Goodbyedpi.WinDivert.dll" Condition="Exists('..\goodbyedpi-0.2.2\goodbyedpi-0.2.2\x86_64\WinDivert.dll')" />
    <EmbeddedResource Include="..\goodbyedpi-0.2.2\goodbyedpi-0.2.2\x86_64\WinDivert64.sys" LogicalName="GUI.Goodbyedpi.WinDivert64.sys" Condition="Exists('..\goodbyedpi-0.2.2\goodbyedpi-0.2.2\x86_64\WinDivert64.sys')" />
  </ItemGroup>

</Project>